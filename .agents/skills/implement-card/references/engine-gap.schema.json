{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mage-go.local/schemas/engine-gap.schema.json",
  "title": "Mage-go engine gap",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "gap_id", "status", "capability", "affected_cards", "oracle_requirements", "rules_references", "required_scenarios", "integration_points", "evidence"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "gap_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["open", "resolved", "accepted_unsupported"]},
    "capability": {"type": "string", "minLength": 1},
    "affected_cards": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "oracle_requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["card", "text"],
        "properties": {
          "card": {"type": "string", "minLength": 1},
          "text": {"type": "string", "minLength": 1}
        }
      }
    },
    "rules_references": {"type": "array", "items": {"type": "string"}},
    "required_scenarios": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "integration_points": {"type": "array", "items": {"type": "string"}},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["api", "tests"],
      "properties": {
        "api": {"type": "array", "items": {"type": "string"}},
        "tests": {"type": "array", "items": {"type": "string"}},
        "limitations": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
