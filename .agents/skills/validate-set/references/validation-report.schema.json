{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mage-go.local/schemas/validation-report.schema.json",
  "title": "Mage-go set validation report",
  "type": "object",
  "additionalProperties": false,
  "x-reconcile-finding-summary": true,
  "required": ["schema_version", "set", "inventory_path", "summary", "findings", "checks", "limitations", "next_work"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "set": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "name", "package"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "package": {"type": "string", "minLength": 1}
      }
    },
    "inventory_path": {"type": "string", "minLength": 1},
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cards_reviewed", "findings_total", "blocker", "error", "warning", "info"],
      "properties": {
        "cards_reviewed": {"type": "integer", "minimum": 0},
        "findings_total": {"type": "integer", "minimum": 0},
        "blocker": {"type": "integer", "minimum": 0},
        "error": {"type": "integer", "minimum": 0},
        "warning": {"type": "integer", "minimum": 0},
        "info": {"type": "integer", "minimum": 0}
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "category", "cards", "authoritative_behavior", "actual_behavior", "evidence", "required_outcome", "confidence"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "severity": {"enum": ["blocker", "error", "warning", "info"]},
          "category": {"enum": ["build", "oracle_mismatch", "incomplete", "unsupported", "test_gap", "engine_gap"]},
          "cards": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "authoritative_behavior": {"type": "string", "minLength": 1},
          "actual_behavior": {"type": "string", "minLength": 1},
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path"],
              "properties": {
                "path": {"type": "string", "minLength": 1},
                "line": {"type": "integer", "minimum": 1},
                "test": {"type": "string"}
              }
            }
          },
          "required_outcome": {"type": "string", "minLength": 1},
          "confidence": {"enum": ["high", "medium", "low"]}
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "status"],
        "properties": {
          "command": {"type": "string", "minLength": 1},
          "status": {"enum": ["passed", "failed", "not_run"]},
          "notes": {"type": "string"}
        }
      }
    },
    "limitations": {"type": "array", "items": {"type": "string"}},
    "next_work": {"type": "array", "items": {"type": "string"}}
  }
}
